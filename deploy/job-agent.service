[Unit]
Description=Поиск вакансий бухгалтера
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jobagent
WorkingDirectory=/opt/job-search-agent
# --sheets — результаты в Google Sheets (нужны service-account.json и GOOGLE_SHEET_ID в .env)
ExecStart=/opt/job-search-agent/.venv/bin/python -m job_agent --sheets
