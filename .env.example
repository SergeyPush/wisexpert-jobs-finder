# Ключ OpenAI (Decisions API): https://platform.openai.com/api-keys
OPENAI_API_KEY=
DECISIONS_MODEL=gpt-6-luna
# Пороги вероятности «подходит под criteria.md»: ≥ KEEP — подходит, ≤ DROP — отброшена
DECISION_KEEP=0.8
DECISION_DROP=0.2
# Спорные (между порогами): save — сохранить с пометкой «проверить» | drop — отбросить
REVIEW_ACTION=save
# Файл критериев (по умолчанию criteria.md в корне проекта)
CRITERIA_FILE=
# Куда писать результаты (по умолчанию CSV; Google Sheets — флаг --sheets)
OUTPUT_CSV=jobs.csv
# ID таблицы из URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# JSON-ключ сервисного аккаунта Google (таблицу нужно расшарить на его email)
GOOGLE_CREDENTIALS=service-account.json
GOOGLE_WORKSHEET=Вакансии
# Если сайты блокируют IP сервера: http://user:pass@host:port
PROXY_URL=
