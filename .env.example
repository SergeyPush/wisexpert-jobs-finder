# Ключ OpenAI (Decisions API): https://platform.openai.com/api-keys
OPENAI_API_KEY=
DECISIONS_MODEL=gpt-6-luna
# Пороги вероятности «подходит под criteria.md»: ≥ KEEP — подходит, ≤ DROP — отброшена
DECISION_KEEP=0.8
DECISION_DROP=0.2
# Спорные (между порогами): save — сохранить с пометкой «проверить» | drop — отбросить
REVIEW_ACTION=save
# Файл критериев (по умолчанию criteria.md в корне проекта)
CRITERIA_FILE=
# Фильтр по названию до классификатора: стоп-/обязательные слова (по умолчанию title-filter.txt в корне)
TITLE_FILTER_FILE=
# Куда писать результаты (по умолчанию CSV; Google Sheets — флаг --sheets)
OUTPUT_CSV=jobs.csv
# ID таблицы из URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# JSON-ключ сервисного аккаунта Google (таблицу нужно расшарить на его email)
GOOGLE_CREDENTIALS=service-account.json
GOOGLE_WORKSHEET=Вакансии
# Лист для отсеянных классификатором вакансий (с вероятностью, уровнем, статусом); создаётся сам
GOOGLE_DROPPED_WORKSHEET=Отсеянные
# Старые листы через запятую (только чтение): вакансии с их id/ссылками не дублируются
GOOGLE_ARCHIVE_WORKSHEETS=
# Уведомления в Telegram: токен от @BotFather, chat_id — свой (например, через @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# problems — только при ошибках и подозрительном нуле | always — ещё и ежедневная сводка
TELEGRAM_NOTIFY=problems
# Если сайты блокируют IP сервера: http://user:pass@host:port
PROXY_URL=
